# Local settings only. Never commit the copied .env or your real app key.
TOGGLY_APP_KEY=
TOGGLY_ENVIRONMENT=Production
TOGGLY_BASE_URL=https://definitions.toggly.io
TOGGLY_REFRESH_INTERVAL=30
# Generate a stable local session signing secret using the README command.
SAMPLE_SESSION_SECRET=
SAMPLE_PRODUCTION=1
SAMPLE_HTTPS=0
