{
  "name": "react-router-sdk-showcase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React Router SDK showcase for the published @ops-ai/react-router-toggly package",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "test": "node --test tests/*.test.mjs && npm run test:browser",
    "test:browser": "node tests/browser.mjs",
    "smoke": "node scripts/configured-runtime-smoke.mjs"
  },
  "dependencies": {
    "@ops-ai/react-router-toggly": "1.5.1",
    "@react-router/node": "8.5.0",
    "@react-router/serve": "8.5.0",
    "isbot": "5.2.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "8.5.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "@ops-ai/toggly-eval": "2.1.1"
  }
}
