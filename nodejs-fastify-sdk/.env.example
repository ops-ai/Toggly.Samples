# Copy to ignored .env.local; dev/start load it after .env. Restart after edits.
# Server-side Node configuration, not a browser VITE_/NEXT_PUBLIC_ variable.
# Selects your Toggly app; leave empty for OFF defaults with no SDK network.
TOGGLY_APP_KEY=
# Selects the app's environment; match the dashboard environment exactly.
TOGGLY_ENVIRONMENT=Production
# Local Fastify listener. Offline mode uses a separate ephemeral fixture port.
PORT=3000
