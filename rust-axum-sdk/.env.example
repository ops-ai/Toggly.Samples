# Export these values in your shell; this app does not load dotenv files.
# Empty or placeholder key selects an explicitly labelled signed loopback fixture.
TOGGLY_APP_KEY=
TOGGLY_ENVIRONMENT=Production
# Optional bind override. Defaults are loopback 127.0.0.1:8017.
# AXUM_PORT=8017
# Optional AES-GCM cookie key. Must decode to at least 64 bytes
# (`openssl rand -hex 64` → 128 hex characters). The app does not panic on
# a shorter or unusable value: it logs and generates an ephemeral per-process
# key instead, which invalidates cookies from earlier runs.
# SAMPLE_COOKIE_KEY=
