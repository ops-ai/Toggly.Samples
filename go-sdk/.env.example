# Copy to .env.local, edit locally, then export these variables before go run.
# Blank key: visible setup banner, no SDK client and no remote requests.
TOGGLY_APP_KEY=
TOGGLY_ENVIRONMENT=Production
# Explicit local signed-fixture practice; ignores the app key when true.
TOGGLY_OFFLINE=false
# Optional live polling override (milliseconds). WebSocket live updates stay on for dashboard apps.
# TOGGLY_REFRESH_INTERVAL_MS=5000
LISTEN_ADDR=127.0.0.1:8080
