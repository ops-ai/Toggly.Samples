# Server-side SDK configuration; no VITE_ or NEXT_PUBLIC_ prefix is needed.
# Copy to ignored .env.local. Empty (or ci-placeholder) means no network and
# false for every missing flag, because this sample supplies no featureDefaults.
TOGGLY_APP_KEY=
# Must match the environment containing your flags; restart after changes.
# This selects Toggly definitions independently of Node development/production.
TOGGLY_ENVIRONMENT=Production
# Local HTTP port, not a Toggly setting. Change browser/curl URLs if changed.
PORT=3000
