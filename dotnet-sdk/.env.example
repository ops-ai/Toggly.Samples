# ASP.NET Core does not automatically read .env files. See README shell steps.
TOGGLY_APP_KEY=
TOGGLY_ENVIRONMENT=Production
# Optional LiveE2E / staging overrides (see TogglyLiveConfiguration):
# TOGGLY_DEFINITIONS_URL=
# TOGGLY_BASE_URL=
# TOGGLY_MGMT_BASE_URL=
# TOGGLY_METRICS_BASE_URL=
ASPNETCORE_URLS=http://localhost:5000
# Offline only: change and restart to practice allowed/denied branches.
Sample__DashboardEnabled=true
Sample__BetaEnabled=true
Sample__ApiEnabled=true
Sample__SubmitEnabled=true
