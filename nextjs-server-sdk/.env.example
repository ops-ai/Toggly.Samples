# Public application identifier for server/edge definition loading, not a management token.
# Copy into .env.local (ignored by git); get the value from your Toggly application.
TOGGLY_APP_KEY=
# NEXT_PUBLIC_ values are exposed in the browser bundle at build time. Use the
# same public application key for the client demos; never put secrets here.
NEXT_PUBLIC_TOGGLY_APP_KEY=
# Server and middleware environment. This selects definitions; it creates none.
TOGGLY_ENVIRONMENT=Production
# For non-Production client demos also set NEXT_PUBLIC_TOGGLY_ENVIRONMENT.
# providers.tsx tries public env -> server env -> Production, but the server-only
# fallback is normally unavailable in a browser bundle. Restart dev / rebuild
# production after changes. Example (uncomment and match the server environment):
# NEXT_PUBLIC_TOGGLY_ENVIRONMENT=Production
