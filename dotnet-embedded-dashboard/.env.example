# ASP.NET Core reads process environment variables, not this file automatically.
# Run from this sample directory so the default database path remains stable.
ASPNETCORE_URLS=http://127.0.0.1:5080
# Optional, server-only connection override. Use a dedicated SQLite database.
ConnectionStrings__TogglyCatalog=Data Source=toggly.sample.db;Pooling=False
# No TOGGLY_APP_KEY is needed. The one logical environment is Production.
