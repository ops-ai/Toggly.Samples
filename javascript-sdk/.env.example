# Copy this file to .env.local; Vite reads it when the dev server starts.
# VITE_ tells Vite to expose a variable to browser code through import.meta.env.
# TOGGLY_APP_KEY is this sample's name; the SDK receives it as config.appKey.
# Use the public browser App Key from your Toggly application, never an admin/API
# secret. Values are visible to site visitors and embedded during a Vite build.
# Empty (or ci-placeholder) selects local demonstration booleans with no fetch.
VITE_TOGGLY_APP_KEY=
# Select the dashboard environment whose flag rules you want to evaluate.
# This is independent of Vite's development/production build mode.
VITE_TOGGLY_ENVIRONMENT=Production
# Restart npm run dev after editing. For production, rebuild and redeploy;
# changing a server environment variable cannot rewrite an already-built bundle.
