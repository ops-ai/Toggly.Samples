{
  "name": "toggly-samples/php-laravel-sdk",
  "description": "Native Laravel feature flag workshop with published Toggly packages",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "~8.5.0",
    "laravel/framework": "^13.31.0",
    "guzzlehttp/guzzle": "^8.2.0",
    "guzzlehttp/psr7": "^3.1.0",
    "toggly/feature-management-php": "^1.0.0",
    "toggly/laravel": "^1.0.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.3.3"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "build": [
      "@php artisan config:cache",
      "@php artisan route:cache",
      "@php artisan view:cache"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": false,
    "optimize-autoloader": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
