# Public browser App Key, never a management API key. Empty starts offline fixtures.
VITE_TOGGLY_APP_KEY=
VITE_TOGGLY_ENVIRONMENT=Production
# Telemetry is enabled by default for a configured app; set false to opt out.
VITE_TOGGLY_ENABLE_TELEMETRY=true
# Optional telemetry destination override; blank uses the SDK default.
VITE_TOGGLY_METRICS_BASE_URL=
