<Project>
  <!-- LiveE2E restores with SampleFramework only. Default AspNetCoreVersion from the framework. -->
  <PropertyGroup>
    <AspNetCoreVersion Condition="'$(AspNetCoreVersion)' == '' and '$(SampleFramework)' == 'net10.0'">10.0.13</AspNetCoreVersion>
    <AspNetCoreVersion Condition="'$(AspNetCoreVersion)' == ''">8.0.33</AspNetCoreVersion>
  </PropertyGroup>
</Project>
