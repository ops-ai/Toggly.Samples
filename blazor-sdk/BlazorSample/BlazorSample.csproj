<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <SampleFramework Condition="'$(SampleFramework)' == ''">net8.0</SampleFramework>
    <TargetFramework>$(SampleFramework)</TargetFramework>
    <AspNetCoreVersion Condition="'$(AspNetCoreVersion)' == ''">8.0.31</AspNetCoreVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Toggly.FeatureManagement.Blazor.Server" Version="0.1.0" />
    <ProjectReference Include="..\BlazorSample.Client\BlazorSample.Client.csproj" />
    <PackageReference
      Include="Microsoft.AspNetCore.Components.WebAssembly.Server"
      Version="$(AspNetCoreVersion)"
    />
  </ItemGroup>
</Project>
