@namespace PublicTelemetryHost
@using Microsoft.AspNetCore.Components.Web
@using Toggly.FeatureManagement.Blazor
@using Toggly.FeatureManagement.Client
@inject IFeatureSession Session
@if (!disposed)
{
<FeatureProvider>
    <Feature Key="on"><span id="enabled">enabled</span></Feature>
    <Feature Key="off" Negate="true"><span id="negated">negated</span></Feature>
    <Feature Keys="@(new[] {"on", "off"})" Requirement="Requirement.Any"><span id="any">any</span></Feature>
</FeatureProvider>
}
<button id="record" @onclick="Record">Record</button>
<button id="evaluate" @onclick="Evaluate">Evaluate gates</button>
<button id="flush" @onclick="Flush">Flush</button>
<button id="mint" @onclick="Mint">Minted identity</button>
<button id="logout" @onclick="Logout">Logout</button>
<button id="dispose" @onclick="DisposeOwner">Dispose</button>
<span id="status">@status</span>
@code {
    private bool disposed;
    private string status = "idle";
    private IFrontendTelemetry Telemetry => (IFrontendTelemetry)Session;
    private void Record() { Telemetry.RecordUsage("checkout", "sample"); Telemetry.RecordView("checkout", "sample"); Telemetry.IncrementCounter("orders", 2); Telemetry.SetGauge("cart", 3.5); status = "recorded"; }
    private async Task Evaluate() {
        var direct = await Session.EvaluateAsync(["on"]);
        var negated = await Session.EvaluateAsync(["off"], negate: true);
        var any = await Session.EvaluateAsync(["off", "on"], Requirement.Any);
        var local = await Session.EvaluateAsync(["local"]);
        var entity = await Session.EvaluateAsync(["order"], entity: new("Order", "sample-order", new Dictionary<string, object?> { ["Vip"] = true }));
        status = $"direct:{direct} negated:{negated} any:{any} local:{local} entity:{entity}";
    }
    private async Task Mint() { await ((IFrontendIdentitySession)Session).SetIdentityAsync(new("minted-user"), "local-minted-token"); status = "minted"; }
    private async Task Logout() { await Session.SetContextAsync(new()); status = "anonymous"; }
    private async Task Flush() { await Telemetry.FlushTelemetryAsync(); status = "flushed"; }
    private async Task DisposeOwner() { disposed = true; await Session.DisposeAsync(); status = "disposed"; }
}
