# Read by the server process environment (not automatically loaded from this file).
# Backend App Key: server only; never copy into client settings or a browser bundle.
TOGGLY_APP_KEY=
# Additional Front-end App Key; intentionally public through /public-toggly.json.
TOGGLY_FRONTEND_APP_KEY=
# Case-sensitive environment; blank keys use the documented offline fixtures/defaults.
TOGGLY_ENVIRONMENT=Production
