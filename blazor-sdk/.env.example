# Read by the server process environment (not automatically loaded from this file).
# Backend App Key: server only; never copy into client settings or a browser bundle.
TOGGLY_APP_KEY=
# Additional Front-end App Key; intentionally public through /public-toggly.json.
TOGGLY_FRONTEND_APP_KEY=
# Case-sensitive environment; blank keys use the documented offline fixtures/defaults.
TOGGLY_ENVIRONMENT=Production

# Optional trusted Server snapshot directory: absolute, private, outside source/content root.
# Requires a Backend App Key. Leave unset to disable persistence.
TOGGLY_SNAPSHOT_DIRECTORY=
# online (default), or offline to restore trusted Server snapshots without service access.
# offline requires a Backend App Key and snapshot directory; it does not enable fixtures.
TOGGLY_NETWORK_MODE=online
# Optional trusted definitions origin; leave unset for Toggly SaaS.
# HTTPS remote, or loopback HTTP for the local signed test. Never a browser setting.
TOGGLY_DEFINITIONS_URL=
