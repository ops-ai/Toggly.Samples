{
  "name": "nestjs-sdk-sample",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local dist/src/main.js",
    "offline": "npm run build && node dist/src/main.js --offline",
    "dev": "npm run build && npm start",
    "test": "npm run build && node --test dist/test/*.test.js",
    "soak": "npm run build && node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/soak.mjs",
    "format": "npm exec --yes --package=prettier@3.6.2 -- prettier --no-error-on-unmatched-pattern --write \"src/**/*.{ts,js,css}\" \"tests/**/*.{ts,mjs,json,md}\" \"test/**/*.{ts,mjs,json,md}\" \"examples/**/*.ts\" \"*.{ts,mjs,json,md}\"",
    "format:check": "npm exec --yes --package=prettier@3.6.2 -- prettier --no-error-on-unmatched-pattern --check \"src/**/*.{ts,js,css}\" \"tests/**/*.{ts,mjs,json,md}\" \"test/**/*.{ts,mjs,json,md}\" \"examples/**/*.ts\" \"*.{ts,mjs,json,md}\"",
    "prebuild": "npm run format:check"
  },
  "dependencies": {
    "@ops-ai/toggly-node-core": "0.13.1",
    "@ops-ai/toggly-nestjs": "0.5.2",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "26.5.1"
  },
  "overrides": {
    "@ops-ai/toggly-node-core": "0.13.1",
    "@ops-ai/toggly-eval": "2.1.1"
  }
}
