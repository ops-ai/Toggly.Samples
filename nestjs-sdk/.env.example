# Server-only key, never bundled into the HTML. Blank selects defaults without network.
TOGGLY_APP_KEY=
# Definition set selected at process startup; restart after changes.
TOGGLY_ENVIRONMENT=Production
# Optional LiveE2E / staging overrides (see dotnet-sdk .env.example):
# TOGGLY_DEFINITIONS_URL=
# TOGGLY_BASE_URL=
# Local Nest HTTP port. No browser-exposure prefix is used.
PORT=3000
