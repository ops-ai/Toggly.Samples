# Private runtime backend key. Never prefix this with VITE_. Empty = demo defaults.
TOGGLY_BACKEND_APP_KEY=
TOGGLY_ENVIRONMENT=Production
TOGGLY_BASE_URL=https://definitions.toggly.io
# Public frontend key and targeting endpoint. Vite embeds these at build time.
# Use a distinct FRONTEND application key; changing VITE_ values requires rebuild.
VITE_TOGGLY_APP_KEY=
VITE_TOGGLY_ENVIRONMENT=Production
VITE_TOGGLY_BASE_URL=https://definitions.toggly.io
# Set to false to disable browser telemetry; default is enabled with an app key.
VITE_TOGGLY_ENABLE_TELEMETRY=true
# Optional metrics endpoint override; independent of the definitions endpoint.
VITE_TOGGLY_METRICS_BASE_URL=
