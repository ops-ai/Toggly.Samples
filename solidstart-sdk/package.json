{
  "name": "toggly-solidstart-sdk-sample",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build --app",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "VITE_TOGGLY_APP_KEY=solidstart-browser-test-key VITE_TOGGLY_BASE_URL=http://127.0.0.1:5198/definitions VITE_TOGGLY_METRICS_BASE_URL=http://127.0.0.1:5198/metrics npm run build && node tests/browser.mjs",
    "test:browser:dev": "node tests/browser.mjs --dev",
    "format": "npm exec --yes --package=prettier@3.6.2 -- prettier --no-error-on-unmatched-pattern --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx,mjs,json,css,html}\" \"*.{ts,mjs,json,md,html}\"",
    "format:check": "npm exec --yes --package=prettier@3.6.2 -- prettier --no-error-on-unmatched-pattern --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx,mjs,json,css,html}\" \"*.{ts,mjs,json,md,html}\"",
    "prebuild": "npm run format:check"
  },
  "dependencies": {
    "@ops-ai/solid-feature-flags-toggly": "0.3.0",
    "@solidjs/router": "1.0.0",
    "@solidjs/start": "2.0.5",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "nitro": "3.0.260903-beta",
    "playwright": "^1.58.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
