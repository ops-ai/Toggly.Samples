{
  "name": "nodejs-express-sdk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Request-scoped Toggly Express showcase",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local src/server.js",
    "offline": "node src/server.js --offline",
    "test": "node --test",
    "build": "node --check src/app.js && node --check src/catalog.js && node --check src/fixture.js && node --check src/server.js && node --check src/view.js",
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local src/server.js"
  },
  "dependencies": {
    "@ops-ai/toggly-express": "0.2.0",
    "@ops-ai/toggly-node-core": "0.9.0",
    "express": "5.2.1"
  }
}
