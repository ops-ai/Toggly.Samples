# Server-only configuration loaded by npm run dev/start, not shipped to a browser.
# Copy to ignored .env.local. Leave empty for defaults-only/no-network mode.
# Use the app key from your Toggly application for live definitions; never commit it.
TOGGLY_APP_KEY=
# Select the environment containing the exact keys from docs/FLAG_TEMPLATE.md.
# Changing this selects another definition set; it does not change request identity.
TOGGLY_ENVIRONMENT=Production
# Local HTTP listener. Restart the server after editing environment values.
PORT=3000
