# Vite substitutes VITE_ values into browser JavaScript at dev/build time.
# Use only the public Toggly App Key, never a management API key or other secret.
# Leave this empty to show the safe missing-key walkthrough with every default off.
VITE_TOGGLY_APP_KEY=

# This is the Toggly environment name, independent of Vite's build mode.
VITE_TOGGLY_ENVIRONMENT=Production
