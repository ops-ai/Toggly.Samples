{
  "name": "remix-sdk-showcase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Remix SDK showcase for the published Toggly Remix packages",
  "scripts": {
    "dev": "remix vite:dev",
    "build": "remix vite:build",
    "start": "remix-serve ./build/server/index.js",
