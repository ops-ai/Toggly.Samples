{
  "name": "remix-sdk-showcase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React Router 8 showcase (remix-sdk folder) for the published @ops-ai/react-router-toggly package",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
