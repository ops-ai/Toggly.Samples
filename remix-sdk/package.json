    "test:browser": "node tests/browser.mjs",
    "smoke": "node scripts/configured-runtime-smoke.mjs"
  },
  "dependencies": {
    "@ops-ai/react-router-toggly": "1.5.1",
    "@react-router/node": "8.5.1",
    "@react-router/serve": "8.5.1",
    "isbot": "5.2.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@react-router/dev": "8.5.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
