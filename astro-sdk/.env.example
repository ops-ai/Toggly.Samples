# Public App Key from Toggly application settings (Client Side API / Frontend key).
# Leave empty to run on documented flagDefaults without calling Toggly.
# Astro exposes these as import.meta.env.* to server code; the integration also
# embeds a client config for island hydration. Never put a management API key here.
TOGGLY_APP_KEY=
TOGGLY_ENVIRONMENT=Production

# Sample-only SSR knob for the /beta/ middleware gate when no App Key is set.
# Live definitions override this once TOGGLY_APP_KEY is configured.
TOGGLY_BETA_ACCESS_DEFAULT=true
