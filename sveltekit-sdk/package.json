{
  "name": "toggly-sveltekit-sample",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "build": "vite build",
    "start": "node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:browser": "playwright test",
    "format": "npm exec --yes --package=prettier@3.6.2 --package=prettier-plugin-svelte@3.4.1 -- node scripts/format.mjs --write",
    "format:check": "npm exec --yes --package=prettier@3.6.2 --package=prettier-plugin-svelte@3.4.1 -- node scripts/format.mjs --check",
    "prebuild": "npm run format:check"
  },
  "dependencies": {
    "@ops-ai/toggly-sveltekit": "^0.1.0"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.55.0",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "svelte": "^5.53.0",
    "svelte-check": "^4.4.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^5.0.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^26.5.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
