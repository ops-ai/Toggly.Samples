{
  "name": "toggly-sveltekit-sample",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "build": "vite build",
    "start": "node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:browser": "playwright test",
    "format": "npm exec --yes --package=prettier@3.6.2 --package=prettier-plugin-svelte@3.4.1 -- node scripts/format.mjs --write",
    "format:check": "npm exec --yes --package=prettier@3.6.2 --package=prettier-plugin-svelte@3.4.1 -- node scripts/format.mjs --check",
    "prebuild": "npm run format:check"
  },
  "dependencies": {
    "@ops-ai/toggly-sveltekit": "0.5.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/node": "^26.6.3",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.5",
    "typescript": "^6.0.0",
    "vite": "^8.0.12",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "overrides": {
    "@ops-ai/toggly-node-core": "0.11.3"
  },
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  }
}
