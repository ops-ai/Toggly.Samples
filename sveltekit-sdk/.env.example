# Backend key: read only by hooks.server.ts; never imported by browser modules.
TOGGLY_APP_KEY=
# Front-end key: PUBLIC_ makes this browser-visible; use App Settings > additional Front-end key.
PUBLIC_TOGGLY_APP_KEY=
# Runtime configuration in adapter-node. Empty keys enable the clearly labelled offline fixture.
TOGGLY_ENVIRONMENT=Production
PUBLIC_TOGGLY_ENVIRONMENT=Production
# Browser telemetry is enabled by default when the Front-end key is configured.
PUBLIC_TOGGLY_ENABLE_TELEMETRY=true
