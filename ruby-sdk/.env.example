# The application reads process environment variables; this file is documentation.
TOGGLY_APP_KEY=
TOGGLY_ENVIRONMENT=Production
TOGGLY_REFRESH_INTERVAL=10
# Optional override for a controlled definitions endpoint. Normally leave unset.
# TOGGLY_DEFINITIONS_URL=
# Optional native file snapshot path; default is ignored tmp/<app-environment-hash>.json.
# TOGGLY_SNAPSHOT_PATH=
# Leave unset for ephemeral demo sessions; set >=64 bytes via runtime env for continuity.
# SESSION_SECRET=
SESSION_COOKIE_SECURE=false
BIND=tcp://127.0.0.1:9292
RACK_ENV=production
