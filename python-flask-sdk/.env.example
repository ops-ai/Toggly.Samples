# Dedicated Python Flask SDK Sample key; blank uses labelled offline fixtures.
TOGGLY_APP_KEY=
TOGGLY_ENVIRONMENT=Production
TOGGLY_REFRESH_INTERVAL=30
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(64))"
FLASK_SECRET_KEY=
# Production WSGI factory requires a stable local secret when this is 1.
SAMPLE_PRODUCTION=1
# Set 1 only behind HTTPS; localhost HTTP needs 0 for session/CSRF cookies.
SAMPLE_HTTPS=0
