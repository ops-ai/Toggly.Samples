# Backend SDK app key, kept on the server. Empty selects explicit offline fixtures.
TOGGLY_APP_KEY=
# Exact Toggly environment; changes require restarting this host.
TOGGLY_ENVIRONMENT=Production
# Local HTTP port. The showcase listens on loopback only.
PORT=4000
# Required for MIX_ENV=prod; dev/test use an ephemeral server-generated secret.
SECRET_KEY_BASE=
