# Backend SDK app key, kept on the server. Empty selects explicit offline fixtures.
TOGGLY_APP_KEY=
# Exact Toggly environment; changes require restarting this host.
TOGGLY_ENVIRONMENT=Production
# Local HTTP port. The showcase listens on loopback only.
PORT=4000
# Required for MIX_ENV=prod; dev/test use an ephemeral server-generated secret.
SECRET_KEY_BASE=
# Optional signed-envelope age in whole seconds (e.g. 86400). Empty/0/negative disables.
# A stale response is rejected; existing verified flags survive, cold starts keep defaults.
# Applies in connected signed mode; the explicit unsigned offline demo is unaffected.
TOGGLY_MAX_SIGNATURE_AGE_SECONDS=

# Optional durable host-owned file for verified live definitions/public JWKS.
# TOGGLY_SNAPSHOT_PATH=/var/lib/my-app/toggly-production.json
